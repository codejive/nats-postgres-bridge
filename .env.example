NATS_SERVERS=nats://127.0.0.1:4222
NATS_USER=
NATS_PASS=
NATS_TOKEN=
NATS_CREDS=
NATS_NAME=nats-postgres-bridge
NATS_TLS=false
NATS_TLS_CA=
NATS_TLS_CERT=
NATS_TLS_KEY=
NATS_CONNECT_TIMEOUT=10000
NATS_RECONNECT_TIME_WAIT=3000
NATS_MAX_RECONNECT_ATTEMPTS=-1
NATS_STREAM=EVENTS
NATS_CONSUMER=postgres
NATS_BATCH_SIZE=100

POSTGRES_URL=postgresql://bridge:change-me@127.0.0.1:5432/bridge
POSTGRES_SCHEMA=public
POSTGRES_TABLE=messages
POSTGRES_TIME_COLUMN=time
POSTGRES_TOPIC_COLUMN=topic
POSTGRES_VALUE_COLUMN=value
POSTGRES_POOL_MAX=5
POSTGRES_CONNECT_TIMEOUT=10000
POSTGRES_QUERY_TIMEOUT=30000

TOPIC_PREFIX=
RETRY_DELAY=3000
SHUTDOWN_TIMEOUT=5000
VERBOSE=false
